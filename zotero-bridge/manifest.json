{
  "manifest_version": 2,
  "name": "Zotrems Bridge",
  "version": "0.2.0",
  "description": "Lets the Zotrems RemNote plugin open Zotero's citation picker and fetch APA-formatted references.",
  "applications": {
    "zotero": {
      "id": "zotrems-bridge@zotrems.local",
      "update_url": "https://github.com/pklaschka/zotrems/releases/latest/download/updates.json",
      "strict_min_version": "7.0",
      "strict_max_version": "11.*"
    }
  }
}
